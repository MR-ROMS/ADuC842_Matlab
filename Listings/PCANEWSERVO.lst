                     122     ; =========================================================================
                     123     ; DONANIMSAL I2C (I2CCON UZERINDEN) YONLENDIRME PROTOKOLU
A51 MACRO ASSEMBLER  PCANEWSERVO                                                          06/23/2026 11:57:51 PAGE     3

                     124     ; =========================================================================
010A                 125     I2C_START:
010A D2EF            126         SETB MDO
010C D2ED            127         SETB MCO
010E 00              128         NOP         ; Cipin hiza yetismesi icin nefes alma payi
010F C2EF            129         CLR MDO
0111 00              130         NOP
0112 C2ED            131         CLR MCO
0114 22              132         RET
                     133     
0115                 134     I2C_STOP:
0115 C2EF            135         CLR MDO
0117 00              136         NOP
0118 D2ED            137         SETB MCO
011A 00              138         NOP
011B D2EF            139         SETB MDO
011D 22              140         RET
                     141     
011E                 142     I2C_YAZ:
011E 7F08            143         MOV R7, #8        
0120                 144     I2C_DONGU:
0120 33              145         RLC A             
0121 92EF            146         MOV MDO, C  ; A'nin en ust bitini Donanimsal SDA pinine (MDO) aktar      
0123 00              147         NOP
0124 D2ED            148         SETB MCO    ; Donanimsal SCL pinini (MCO) High yap
0126 00              149         NOP
0127 00              150         NOP          
0128 C2ED            151         CLR MCO     ; SCL pinini Low yap
012A DFF4            152         DJNZ R7, I2C_DONGU
                     153         
                     154         ; ACK (Onay) Okuma Boslugu
012C D2EF            155         SETB MDO
012E 00              156         NOP          
012F D2ED            157         SETB MCO
0131 00              158         NOP
0132 00              159         NOP          
0133 C2ED            160         CLR MCO           
0135 22              161         RET
                     162     
                     163     ; =========================================================================
                     164     ; GECIKME ALT PROGRAMLARI
                     165     ; =========================================================================
                     166     ; Cipin uyanmasi ve osilatorun oturmasi icin minik bir gecikme
0136                 167     KISA_GECIKME:
0136 7EFF            168         MOV R6, #255
0138 DEFE            169     G1: DJNZ R6, G1
013A 22              170         RET
                     171     
                     172     ; Motorun bir uctan digerine gitmesi icin gereken zamani taniyan gecikme
013B                 173     UZUN_GECIKME:
013B 7D0A            174         MOV R5, #10
013D 7EFF            175     U1: MOV R6, #255
013F 7FFF            176     U2: MOV R7, #255
0141 DFFE            177     U3: DJNZ R7, U3
0143 DEFA            178         DJNZ R6, U2
0145 DDF6            179         DJNZ R5, U1
0147 22              180         RET
                     181     
                     182     END
