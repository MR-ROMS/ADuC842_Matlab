                       3     ; =========================================================================
                       4     ; REGISTER VE DONANIMSAL I2C TANIMLAMALARI
                       5     ; =========================================================================
  00E8                 6     I2CCON DATA 0E8H   ; I2C Kontrol Registeri Adresi
  00F8                 7     SPICON DATA 0F8H   ; SPI Kontrol Registeri Adresi
                       8     
                       9     ; --- I2CCON BITLERI (Ozel I2C Donanim Pinlerine Hukmeder) ---
  00EF                10     MDO  BIT 0EFH  ; I2CCON.7 (SDATA Pinine Veri Yazar)
  00ED                11     MCO  BIT 0EDH  ; I2CCON.5 (SCLOCK Pinine Saat Sinyali Yazar)
                      12     
  0080                13     PCA_ADDR EQU 80H  
                      14     
----                  15     CSEG
0000                  16     ORG 0000H
0000 805E             17         SJMP BASLA
                      18     
0060                  19     ORG 0060H
0060                  20     BASLA:
                      21         ; 1. ADIM: Donanimsal I2C Pinlerini (J0) Uyandir!
0060 75F800           22         MOV SPICON, #00H   ; SPI pinlerini kapat ki I2C ile cakismasin
                      23         ; I2CM=1 (Master), MDE=1 (Cikis Aktif), MDO=1 (SDA High), MCO=1 (SCL High)
0063 75E8E8           24         MOV I2CCON, #0E8H  
                      25         
                      26         ; 2. ADIM: PCA9685'i Hazirla ve 50Hz'e Ayarla
0066 120077           27         LCALL PCA_KURULUM
                      28     
0069                  29     SONSUZ_DONGU:
                      30         ; 1. Sifir Dereceye Git ve Bekle
0069 1200C0           31         LCALL SERVO_0_SIFIR_DERECE
006C 12013B           32         LCALL UZUN_GECIKME
                      33     
                      34         ; 2. Yuz Seksen Dereceye Git ve Bekle
006F 1200E5           35         LCALL SERVO_0_YUZSEKSEN_DERECE
0072 12013B           36         LCALL UZUN_GECIKME
                      37     
                      38         ; Basa don ve surekli tekrarla
0075 80F2             39         SJMP SONSUZ_DONGU  
                      40     
                      41     ; =========================================================================
                      42     ; PCA9685 ILK KURULUM (INIT) ALT PROGRAMI
                      43     ; =========================================================================
0077                  44     PCA_KURULUM:
                      45         ; Cipi Sleep moduna al
0077 12010A           46         LCALL I2C_START
007A 7480             47         MOV A, #PCA_ADDR
007C 12011E           48         LCALL I2C_YAZ
007F 7400             49         MOV A, #00H       
0081 12011E           50         LCALL I2C_YAZ
0084 7410             51         MOV A, #10H       
0086 12011E           52         LCALL I2C_YAZ
0089 120115           53         LCALL I2C_STOP
008C 120136           54         LCALL KISA_GECIKME
                      55     
                      56         ; Prescaler'i 50 Hz ayarla (Hex: 79H)
008F 12010A           57         LCALL I2C_START
